{
  "builds": [
    {
      "src": "api/briefing-worker.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "server.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/briefing-worker",
      "dest": "api/briefing-worker.mjs"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.py"
    },
    {
      "src": "/(.*)",
      "dest": "static/$1"
    }
  ]
}
