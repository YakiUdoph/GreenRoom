{
  "builds": [
    {
      "src": "api/briefing-worker.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "server.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/briefing-worker",
      "dest": "api/briefing-worker.mjs"
    },
    {
      "src": "/api/(.*)",
      "dest": "server.py"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
